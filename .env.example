# Database (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/delta_ci?sslmode=disable

# Orchestrator
LISTEN=:8080

# GitHub integration (optional)
# GITHUB_WEBHOOK_SECRET=
# GITHUB_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=
# GITHUB_API_URL=
# GITHUB_CHECK_NAME=

# AI failure analysis (optional)
# DELTA_AI_ENABLED=true
# DELTA_AI_PROVIDER=openai
# DELTA_AI_MODEL=gpt-4o-mini
# DELTA_AI_ENDPOINT=http://localhost:8090/v1/explain
# DELTA_AI_TOKEN=
# DELTA_AI_PROMPT_VERSION=v1
# DELTA_AI_TIMEOUT=3s
# DELTA_AI_MAX_OUTPUT_LEN=4096
# DELTA_AI_MAX_CACHE_EVENTS=10
# DELTA_AI_CIRCUIT_FAILURES=5
# DELTA_AI_CIRCUIT_COOLDOWN=30s

# S3 artifact storage (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=
# S3_PREFIX=
