FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ai-proxy ./cmd/ai-proxy

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/ai-proxy /usr/local/bin/ai-proxy
USER nonroot:nonroot
ENTRYPOINT ["ai-proxy"]
